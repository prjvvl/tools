---
import { Search } from "@lucide/astro";
import { tools, categories } from "../tools/registry";

const categoryLabel = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const paletteData = tools.map((t) => ({
  slug: t.slug,
  title: t.title,
  description: t.description,
  category: categoryLabel[t.category],
}));
---

<button
  id="command-palette-trigger"
  type="button"
  class="hover-elevate hidden min-h-11 items-center gap-2 rounded-card border border-border px-3 text-sm text-fg-muted md:inline-flex"
  aria-label="Search tools"
>
  <Search class="size-4" aria-hidden="true" />
  <span>Search tools...</span>
  <kbd class="rounded border border-border px-1.5 py-0.5 font-sans text-xs text-fg-muted">Ctrl K</kbd>
</button>

<script type="application/json" id="command-palette-data" is:inline set:html={JSON.stringify(paletteData)} />

<div
  id="command-palette-overlay"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-bg/80 backdrop-blur-sm"
  style="padding-top: max(4rem, env(safe-area-inset-top))"
  hidden
>
  <div
    id="command-palette-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Search tools"
    class="mx-4 w-full max-w-lg rounded-card border border-border bg-surface shadow-lg"
  >
    <div class="flex items-center gap-2 border-b border-border px-4">
      <Search class="size-4 shrink-0 text-fg-muted" aria-hidden="true" />
      <input
        id="command-palette-input"
        type="text"
        placeholder="Search tools..."
        autocomplete="off"
        spellcheck="false"
        class="min-h-12 w-full bg-transparent text-sm text-fg placeholder:text-fg-muted focus:outline-none"
      />
    </div>
    <ul id="command-palette-results" class="max-h-80 overflow-y-auto p-2" role="listbox"></ul>
    <p id="command-palette-empty" class="p-6 text-center text-sm text-fg-muted" hidden>No tools match your search.</p>
  </div>
</div>

<script>
  import { withBase } from "../lib/url";
  import { searchTools } from "../lib/search";

  interface PaletteTool {
    slug: string;
    title: string;
    description: string;
    category: string;
  }

  (function () {
    const dataEl = document.getElementById("command-palette-data");
    const allTools: PaletteTool[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];

    const trigger = document.getElementById("command-palette-trigger");
    const overlay = document.getElementById("command-palette-overlay");
    const dialog = document.getElementById("command-palette-dialog");
    const input = document.getElementById("command-palette-input") as HTMLInputElement | null;
    const results = document.getElementById("command-palette-results");
    const emptyState = document.getElementById("command-palette-empty");

    if (!overlay || !dialog || !input || !results || !emptyState) return;

    let activeIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function render(list: PaletteTool[]) {
      results!.innerHTML = "";
      emptyState!.hidden = list.length > 0;
      activeIndex = 0;

      list.forEach((tool, index) => {
        const li = document.createElement("li");
        li.setAttribute("role", "option");
        li.id = `command-palette-option-${index}`;
        li.dataset.slug = tool.slug;
        li.setAttribute("aria-selected", String(index === activeIndex));
        li.className = `flex cursor-pointer flex-col rounded-card px-3 py-2 ${
          index === activeIndex ? "bg-bg" : ""
        }`;
        li.innerHTML = `
          <span class="text-sm font-medium text-fg">${tool.title}</span>
          <span class="text-xs text-fg-muted">${tool.category} &middot; ${tool.description}</span>
        `;
        li.addEventListener("mouseenter", () => setActive(index));
        li.addEventListener("click", () => go(tool.slug));
        results!.appendChild(li);
      });

      input!.setAttribute("aria-activedescendant", list.length ? `command-palette-option-0` : "");
    }

    function currentList(): PaletteTool[] {
      return searchTools(allTools, input!.value);
    }

    function setActive(index: number) {
      const items = results!.querySelectorAll<HTMLLIElement>("li");
      if (!items.length) return;
      activeIndex = (index + items.length) % items.length;
      items.forEach((item, i) => {
        const isActive = i === activeIndex;
        item.classList.toggle("bg-bg", isActive);
        item.setAttribute("aria-selected", String(isActive));
      });
      input!.setAttribute("aria-activedescendant", `command-palette-option-${activeIndex}`);
      items[activeIndex]?.scrollIntoView({ block: "nearest" });
    }

    function go(slug: string) {
      window.location.href = withBase(`/${slug}`);
    }

    function open() {
      lastFocused = document.activeElement as HTMLElement | null;
      overlay!.hidden = false;
      overlay!.classList.remove("hidden");
      overlay!.classList.add("flex");
      input!.value = "";
      render(allTools);
      input!.focus();
      document.body.style.overflow = "hidden";
    }

    function close() {
      overlay!.hidden = true;
      overlay!.classList.add("hidden");
      overlay!.classList.remove("flex");
      document.body.style.overflow = "";
      lastFocused?.focus();
    }

    trigger?.addEventListener("click", open);
    document.addEventListener("open-command-palette", open);

    document.addEventListener("keydown", (event) => {
      const isShortcut = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k";
      if (isShortcut) {
        event.preventDefault();
        overlay!.hidden ? open() : close();
        return;
      }
      if (event.key === "Escape" && !overlay!.hidden) {
        close();
      }
    });

    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) close();
    });

    input.addEventListener("input", () => render(currentList()));

    input.addEventListener("keydown", (event) => {
      const items = results!.querySelectorAll<HTMLLIElement>("li");
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === "Enter") {
        event.preventDefault();
        const slug = items[activeIndex]?.dataset.slug;
        if (slug) go(slug);
      }
    });
  })();
</script>
