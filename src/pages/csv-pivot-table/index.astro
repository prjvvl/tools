---
import ToolLayout from "../../layouts/ToolLayout.astro";
import CsvPivotTableTool from "../../tools/csv-pivot-table/CsvPivotTableTool";
import { tools } from "../../tools/registry";

const tool = tools.find((t) => t.slug === "csv-pivot-table")!;
---

<ToolLayout title={tool.title} description={tool.description}>
  <CsvPivotTableTool client:only="react" />
</ToolLayout>
