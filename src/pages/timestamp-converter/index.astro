---
import ToolLayout from "../../layouts/ToolLayout.astro";
import TimestampConverter from "../../tools/timestamp-converter/TimestampConverter";
import { tools } from "../../tools/registry";

const tool = tools.find((t) => t.slug === "timestamp-converter")!;
---

<ToolLayout title={tool.title} description={tool.description}>
  <TimestampConverter client:only="react" />
</ToolLayout>
