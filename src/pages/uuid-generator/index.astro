---
import ToolLayout from "../../layouts/ToolLayout.astro";
import UuidGenerator from "../../tools/uuid-generator/UuidGenerator";
import { tools } from "../../tools/registry";

const tool = tools.find((t) => t.slug === "uuid-generator")!;
---

<ToolLayout title={tool.title} description={tool.description}>
  <UuidGenerator client:only="react" />
</ToolLayout>
