---
import ToolLayout from "../../layouts/ToolLayout.astro";
import HashGenerator from "../../tools/hash-generator/HashGenerator";
import { tools } from "../../tools/registry";

const tool = tools.find((t) => t.slug === "hash-generator")!;
---

<ToolLayout title={tool.title} description={tool.description}>
  <HashGenerator client:only="react" />
</ToolLayout>
