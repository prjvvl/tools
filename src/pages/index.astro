---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import { siteConfig } from "../site.config";
import { tools } from "../tools/registry";
---

<BaseLayout title={siteConfig.name}>
  <section class="mx-auto max-w-5xl px-4 pt-10 pb-20">
    <h1 class="sr-only">{siteConfig.name}</h1>
    <div class="mx-auto mb-8 max-w-md">
      <label for="tool-search" class="sr-only">Search tools</label>
      <input
        id="tool-search"
        type="search"
        placeholder="Search tools..."
        class="min-h-11 w-full rounded-card border border-border bg-bg px-3 text-sm text-fg placeholder:text-fg-muted focus:border-brand-300 focus:outline-none"
      />
    </div>

    <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {
        tools.map(({ slug, title, description, icon: Icon }) => (
          <div data-tool-card data-search={`${title} ${description}`.toLowerCase()}>
            <Card href={`/${slug}`} title={title} description={description}>
              <Icon slot="icon" class="size-5 text-brand" aria-hidden="true" />
            </Card>
          </div>
        ))
      }
    </div>

    <p id="tool-search-empty" class="mt-6 text-center text-sm text-fg-muted" hidden>
      No tools match your search.
    </p>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById("tool-search") as HTMLInputElement | null;
  const emptyState = document.getElementById("tool-search-empty");

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    const cards = document.querySelectorAll<HTMLElement>("[data-tool-card]");
    let visibleCount = 0;

    cards.forEach((card) => {
      const matches = (card.dataset.search ?? "").includes(query);
      card.hidden = !matches;
      if (matches) visibleCount++;
    });

    if (emptyState) emptyState.hidden = visibleCount > 0;
  });
</script>
